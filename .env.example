# Copy this file to `.env` (same folder) before running the project.

# MongoDB connection string. Connect MongoDB Compass to mongodb://localhost:27017
# and you'll see the `racing_game` database with users / garages / racerecords.
MONGO_URI=mongodb://localhost:27017/racing_game

# Port for the Express REST API + Socket.io server.
PORT=4000

# Port for the Vite dev server (the game client).
CLIENT_PORT=5173

# Browser origin allowed by CORS / Socket.io (the Vite dev server URL).
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Use a long random string; required in production.
JWT_SECRET=change-me-to-a-long-random-string

# How often (Hz) the server broadcasts vehicle snapshots to each room (10-60).
TICK_RATE=30
